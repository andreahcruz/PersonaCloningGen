# Python 3.10+ so chromadb → posthog (telemetry) types using dict[str, ...] work (3.8 raises TypeError).
FROM apache/airflow:2.8.1-python3.10

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

USER airflow
# Spark provider: unpinned releases may require Airflow 2.11+ and break this 2.8.1 image.
RUN pip install --no-cache-dir \
    pyspark==3.5.0 \
    boto3 \
    chromadb \
    "posthog>=2.4.0,<3.0.0" \
    requests \
    beautifulsoup4 \
    nltk \
    apache-airflow-providers-apache-spark==4.7.1
