# Optional: override defaults for local development (most settings live in docker-compose.yml)
# SFT / VRAM (must stay aligned: Spark export chunk width ≈ 3.125 × MAX_SEQ_LENGTH)
# MAX_SEQ_LENGTH=512
# SFT_CHUNK_OUTPUT_CHARS=1600
# DATASET_MAX_OUTPUT_CHARS=2000
#
# LoRA (VRAM heavy; narrower on OOM):
# LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj
# LORA_R=16
# LORA_ALPHA=32
#
# Dataset cleaning (clean_dataset):
# SCRUB_TRANSCRIPT_TAGS=1
# DEDUPE_EXACT_OUTPUT=1
#
# BitsAndBytes explicit NF4 + double quant in finetune/probe:
# USE_EXPLICIT_BNB_CONFIG=1
#
# Skip the automatic `ollama run` ping after FT → merge → register_ollama
# SKIP_OLLAMA_SMOKE_TEST=1
#
# Logging and failure handling:
# LOG_LEVEL=INFO                          # DEBUG for more detail (Streamlit, CLI, Spark driver)
# MAX_MISSING_EMBEDDING_FRACTION=0.10     # fail load_to_chroma / Spark when more chunk rows lack embeddings
# OLLAMA_EMBED_RETRIES=2                  # extra attempts on connection errors, timeouts and HTTP 5xx
# OLLAMA_GENERATE_RETRIES=1               # extra attempts on connection errors and HTTP 5xx (not timeouts)
# OLLAMA_EMBED_TIMEOUT=60                 # seconds
# OLLAMA_GENERATE_TIMEOUT=900             # seconds
#
# Relabel + factual RAG inference (host_finetune.compare_adapters).
# Leave these unset to keep the historical three-adapter default.
# Do not point inference at CHROMA_COLLECTION_NAME=lemkin_content.
# RELABEL_ADAPTER_PATH=host_finetune/output/lemkin_lora_relabel
# CHROMA_PERSIST_DIR=host_finetune/output/chroma_lemkin_train_only
# OLLAMA_BASE=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EXPERIMENT_OUT_DIR=experiments/EXP-20261005-003-relabel-rag-final
