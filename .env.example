# Copy to .env (gitignored; on a server also `chmod 600 .env`). Never commit real values.
#
# ── Required by docker-compose.yml (compose refuses to start without them) ──
# Use URL-safe characters (letters, digits, - _) — POSTGRES_PASSWORD is embedded in a DB URL.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Only applied when the postgres-data volume is first created. An existing local volume was
# initialised with "airflow"; keep that value or run `docker compose down -v` to recreate it.
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW__WEBSERVER__SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
#
# ── Pipeline deployment overrides (defaults shown are used when unset) ──
# LEMKIN_DATA_DIR=/opt/airflow/data                 # /opt/airflow/data/cleaned = cleaned corpus
# PERSONA_LOCAL_PATH=/opt/airflow/data/persona_profile.json
# OLLAMA_BASE=http://host.docker.internal:11434     # AWS (docker-compose.aws.yml): http://ollama:11434
# SPARK_EMBED_PARTITIONS=16                         # CPU-only Ollama: 2-4
# MINIO_HOST_API_PORT=9000                          # host bind only; change if 9000 is taken
# MINIO_HOST_CONSOLE_PORT=9001
# The React service binds to localhost:3000 on EC2; use an SSH tunnel to view it.
# API_INTERNAL_URL=http://backend:8000
#
# Optional: override defaults for local development (most settings live in docker-compose.yml)
# SFT / VRAM (must stay aligned: Spark export chunk width ≈ 3.125 × MAX_SEQ_LENGTH)
# MAX_SEQ_LENGTH=512
# SFT_CHUNK_OUTPUT_CHARS=1600
# DATASET_MAX_OUTPUT_CHARS=2000
#
# LoRA (VRAM heavy; narrower on OOM):
# LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj
# LORA_R=16
# LORA_ALPHA=32
#
# Dataset cleaning (clean_dataset):
# SCRUB_TRANSCRIPT_TAGS=1
# DEDUPE_EXACT_OUTPUT=1
#
# BitsAndBytes explicit NF4 + double quant in finetune/probe:
# USE_EXPLICIT_BNB_CONFIG=1
#
# Skip the automatic `ollama run` ping after FT → merge → register_ollama
# SKIP_OLLAMA_SMOKE_TEST=1
#
# Logging and failure handling:
# LOG_LEVEL=INFO                          # DEBUG for more detail (Streamlit, CLI, Spark driver)
# MAX_MISSING_EMBEDDING_FRACTION=0.10     # fail load_to_chroma / Spark when more chunk rows lack embeddings
# OLLAMA_EMBED_RETRIES=2                  # extra attempts on connection errors, timeouts and HTTP 5xx
# OLLAMA_GENERATE_RETRIES=1               # extra attempts on connection errors and HTTP 5xx (not timeouts)
# OLLAMA_EMBED_TIMEOUT=60                 # seconds
# OLLAMA_GENERATE_TIMEOUT=900             # seconds
